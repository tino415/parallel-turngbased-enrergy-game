{
  "name": "parallel-turn-based-energy-game",
  "private": true,
  "version": "0.8.4",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm run format:check && node --check src/engine.js && node --check src/game.js && npm test",
    "build": "node scripts/build.mjs",
    "test:ui": "playwright test",
    "test:ui:report": "playwright show-report",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "simulate": "node scripts/simulate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "3.6.2"
  }
}
